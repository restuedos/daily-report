# Production example (optional) — branch `dev` focuses on local MySQL
# Prefer deploying with the same MySQL + filesystem approach, or use branch `main` for Docker/MinIO/Postgres.

DATABASE_URL=mysql://dailyreport:change-me@127.0.0.1:3306/dailyreport
AUTH_SECRET=change-me-to-a-long-random-string-32+
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=change-me-to-a-long-random-string-32+
APP_URL=https://your-domain.example
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator
STORAGE_DIR=/var/lib/daily-report/storage
NODE_ENV=production
