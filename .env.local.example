# Local development (no Docker / no MinIO / MySQL)
#
# Requires a local MySQL or MariaDB instance.
# Example setup:
#   sudo mysql -e "CREATE DATABASE dailyreport CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#   sudo mysql -e "CREATE USER 'dailyreport'@'localhost' IDENTIFIED BY 'dailyreport';"
#   sudo mysql -e "GRANT ALL ON dailyreport.* TO 'dailyreport'@'localhost'; FLUSH PRIVILEGES;"

DATABASE_URL=mysql://dailyreport:dailyreport@127.0.0.1:3306/dailyreport

AUTH_SECRET=local-dev-secret-change-me-please-32chars
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=local-dev-secret-change-me-please-32chars
APP_URL=http://127.0.0.1:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Local filesystem uploads (relative to project root or absolute path)
STORAGE_DIR=./storage

NODE_ENV=development
