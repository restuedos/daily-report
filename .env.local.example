# Host development (.env.local for Next.js on the host)
POSTGRES_USER=dailyreport
POSTGRES_PASSWORD=dailyreport_local
POSTGRES_DB=dailyreport
POSTGRES_PORT=55432
DATABASE_URL=postgresql://dailyreport:dailyreport_local@127.0.0.1:55432/dailyreport?schema=public

AUTH_SECRET=local-dev-secret-change-me-please-32chars
NEXTAUTH_URL=http://127.0.0.1:3005
NEXTAUTH_SECRET=local-dev-secret-change-me-please-32chars
APP_URL=http://127.0.0.1:3005
HTTP_PORT=8080
HTTPS_PORT=8443

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=daily-report
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_PUBLIC_URL=http://127.0.0.1:19000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

NODE_ENV=development
